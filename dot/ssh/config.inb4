Host git.cynic.net.
    ForwardAgent no
    ForwardX11 no

Host *.cynic.net.
    ForwardAgent yes

Host ssh.github.com.
    #   Host with SSH on port 443 to help get around firewalls.
    Port 443

Host pssh.github.com.
    #   Connect via proxy specified in `*_proxy` env vars.
    HostKeyAlias ssh.github.com.
    HostName ssh.github.com.
    Port 443
    User git
    ProxyCommand connect-proxy %h %p

Host gitlab.com.
    #   We force IPv4 because, at least on some Japanese home connections,
    #   the IPv6 connectivity is broken, perhaps due to PMTU filtering issues.
    AddressFamily inet
    #   This fixes the GitLab 'send-pack: unexpected disconnect while
    #   reading sideband packet' problem.
    #   "This targets a known class of bug where some routers/middleboxes
    #   mishandle DSCP-tagged packets that OpenSSH started sending by
    #   default years ago, causing mid-transfer drops specifically on
    #   larger writes. This is not GitLab-specific...."
    IPQoS throughput
